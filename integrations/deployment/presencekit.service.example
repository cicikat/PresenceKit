[Unit]
Description=PresenceKit Backend
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=presencekit
Group=presencekit
WorkingDirectory=/opt/presencekit
ExecStart=/opt/presencekit/.venv/bin/python /opt/presencekit/main.py
EnvironmentFile=-/etc/presencekit/backend.env
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
Restart=on-failure
RestartSec=8
TimeoutStopSec=90
KillSignal=SIGINT
UMask=0077

[Install]
WantedBy=multi-user.target
